<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#0F2836"> <!-- Color de fondo oscuro -->

    <!-- ESPACIO PARA TU LOGO DEL BÚHO -->
    <!-- Nota: Por ahora puse un ícono de cámara por defecto.
         Luego cambiaremos el 'src' por tu imagen del búho -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/logo_buho"
        app:tint="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <!-- Título -->
    <TextView
        android:id="@+id/tvTitleLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="@string/tvTitleLogin"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Campo: Correo Institucional -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/etEmail"
        android:textColorHint="#8A9EAB"
        app:boxStrokeColor="#3A5A6E"
        app:boxBackgroundColor="#1A3646"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:startIconDrawable="@android:drawable/ic_dialog_email"
        app:startIconTint="#8A9EAB"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textColor="#FFFFFF" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Campo: Contraseña -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/EtPassword"
        android:textColorHint="#8A9EAB"
        app:boxStrokeColor="#3A5A6E"
        app:boxBackgroundColor="#1A3646"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
        app:startIconTint="#8A9EAB"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="#8A9EAB"
        android:layout_marginBottom="32dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="#FFFFFF" />
    </com.google.android.material.textfield.TextInputLayout>

    <!--olvido de contraseña-->
    <TextView
        android:id="@+id/tvOlvidoPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tvOlvidoPassword"
        android:textColor="#38B6FF"
        android:textAlignment="viewEnd"
        android:layout_marginBottom="24dp"
        android:textStyle="bold" />

    <!-- Botón Entrar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btnLogin"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:backgroundTint="#167984"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp"/>

    <!-- Texto ¿No tienes cuenta? Regístrate. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNoCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tvNoCuenta"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRegistrarse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tvRegistrarse"
            android:textColor="#39A7B3"
            android:textStyle="bold"
            android:textSize="14sp" />


    </LinearLayout>

</LinearLayout>